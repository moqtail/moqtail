# Settings for tools/perf-test.sh. Copy to tools/perf-test.env (gitignored) and edit.
#
# Sourced as a shell fragment, so $HOME and command substitution work. Everything
# here is a default: a command-line flag still wins. Point PERF_TEST_ENV at another
# file to use that one instead.

# Where moxygen's moqtest_server and moqperf_test_client live. No default: the
# binaries are built outside this repo.
MOQBIN="$HOME/src/moxygen/install/bin"

# Run the relay on another host over ssh, with the publisher and subscriber staying
# local. Leave unset to run everything on this machine.
#REMOTE_RELAY_HOST="relay"

# Checkout on that host to sync sources into, relative to its home unless absolute.
#REMOTE_PATH="projects/moqtail"

# Load shape.
#SUBSCRIBER_MAX=1000
#RAMP=100
#DURATION=60
#CLIENT_THREADS=8

# Seconds of perf profiling on the remote relay, once the ramp has finished.
#REMOTE_PERF=25

# RUST_LOG for the relay. Info logs every control message and will itself dominate
# the measurement.
#RELAY_LOG_SPEC="warn"
