{
  "type": "module",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "changeset": "changeset",
    "changeset:release": "npm run build && changeset publish",
    "version": "changeset version && node scripts/postversion.mjs",
    "build": "npm --prefix libs/moqtail-ts run build && npm --prefix apps/client-js run build && npm --prefix apps/meet run build",
    "test": "npm --prefix libs/moqtail-ts run test -- run",
    "format": "npm --prefix libs/moqtail-ts run format && npm --prefix apps/client-js run format && npm --prefix apps/meet run format",
    "docs:api": "npm --prefix libs/moqtail-ts run docs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "glob": "^14.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.3.0",
    "posthog-js": "^1.447.0",
    "prettier": "^3.9.10",
    "prompts": "^2.4.2",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.15.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
