{
  "name": "moqtail",
  "version": "0.16.0",
  "description": "Media Over QUIC Transport client implementation",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "keywords": [
    "moqtail",
    "moq",
    "media",
    "quic",
    "transport",
    "streaming"
  ],
  "homepage": "https://moqtail.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moqtail/moqtail.git",
    "directory": "libs/moqtail-ts"
  },
  "bugs": {
    "url": "https://github.com/moqtail/moqtail/issues"
  },
  "author": {
    "name": "Streaming University",
    "email": "info@moqtail.dev",
    "url": "https://moqtail.dev"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/model.d.mts",
        "default": "./dist/model.mjs"
      },
      "require": {
        "types": "./dist/model.d.cts",
        "default": "./dist/model.cjs"
      }
    },
    "./player": {
      "import": {
        "types": "./dist/player.d.mts",
        "default": "./dist/player.mjs"
      },
      "require": {
        "types": "./dist/player.d.cts",
        "default": "./dist/player.cjs"
      }
    },
    "./player/component": {
      "import": {
        "types": "./dist/player/component.d.mts",
        "default": "./dist/player/component.mjs"
      },
      "require": {
        "types": "./dist/player/component.d.cts",
        "default": "./dist/player/component.cjs"
      }
    },
    "./util": {
      "import": {
        "types": "./dist/util.d.mts",
        "default": "./dist/util.mjs"
      },
      "require": {
        "types": "./dist/util.d.cts",
        "default": "./dist/util.cjs"
      }
    }
  },
  "scripts": {
    "prepare": "npm run transpile",
    "transpile": "tsdown",
    "build": "tsc --noEmit && npm run transpile && api-extractor run",
    "test": "vitest",
    "format": "prettier --check .",
    "test:run": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@tsconfig/strictest": "^2.0.8",
    "@vitest/browser-playwright": "5.1.0",
    "custom-media-element": "^1.4.7",
    "media-tracks": "^0.3.5",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "custom-media-element": "^1.4.7",
    "media-tracks": "^0.3.5"
  },
  "peerDependenciesMeta": {
    "custom-media-element": {
      "optional": true
    },
    "media-tracks": {
      "optional": true
    }
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
